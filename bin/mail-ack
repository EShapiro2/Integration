#!/bin/bash
# Records as acted on every entry of Code_inbox.md whose Date is one of the arguments ("2026-11-03 09:45"), in Code/docs/mail-ledger.txt, which bin/mail-due holds the inbox against (Code #22, 2026-11-03).  Run it only after acting on each entry of those Dates.
ledger=/Users/udi/Grassroots/Code/docs/mail-ledger.txt
touch "$ledger"
for d in "$@"; do
  /Users/udi/Grassroots/Code/bin/mail-entries | grep -F "$d UTC |" | while IFS= read -r e; do
    grep -qxF "$e" "$ledger" || { echo "$e" >> "$ledger"; echo "acked: $e"; }
  done
done
