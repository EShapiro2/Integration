#!/bin/bash
# UserPromptSubmit hook of the Code session (Udi, 2026-10-19): when Code's last receipt in Code_inbox.md is more than two minutes old, it prints a line telling Code to read its mail before it answers Udi.  It prints nothing otherwise, and never blocks the prompt.
inbox=/Users/udi/Grassroots/Coordination/mail/Code_inbox.md
cat > /dev/null
last=$(grep -E '^Read: Code #[0-9]+ [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} UTC$' "$inbox" 2>/dev/null | tail -1)
if [ -z "$last" ]; then
  echo "Code: Code_inbox.md has no receipt of Code's.  Before you answer Udi, read your mail: /Users/udi/Grassroots/Coordination/bin/mail-read Code \"Code #N\", your own name, and act on it."
  exit 0
fi
who=$(printf '%s\n' "$last" | sed -E 's/^Read: (Code #[0-9]+) .*$/\1/')
ts=$(printf '%s\n' "$last" | sed -E 's/^Read: Code #[0-9]+ ([0-9-]+ [0-9:]+) UTC$/\1/')
then_s=$(date -j -u -f '%Y-%m-%d %H:%M:%S' "$ts:00" +%s 2>/dev/null) || exit 0
now_s=$(date -u +%s)
if [ $((now_s - then_s)) -gt 120 ]; then
  echo "Code: the last receipt in Code_inbox.md is $who's at $ts UTC, more than two minutes ago.  Before you answer Udi, read your mail: /Users/udi/Grassroots/Coordination/bin/mail-read Code \"Code #N\", your own name, and act on it."
fi
exit 0
